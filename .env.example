# ------------------------------------------------------------------------------
# Bregenz Barbershop — Umgebungsvariablen
# .env NIEMALS committen (siehe .gitignore). Auf Vercel unter Project Settings →
# Environment Variables eintragen.
# ------------------------------------------------------------------------------

# Postgres. Lokal läuft in Docker eine Instanz auf Port 5433.
# Auf Vercel: fehlt DATABASE_URL, greift die Anwendung auf POSTGRES_URL zurück,
# das die Supabase-Integration selbst anlegt — dort ist hier nichts einzutragen.
# db:migrate und db:seed bevorzugen POSTGRES_URL_NON_POOLING (direkt, ohne Pooler).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/barbershop

# Schlüssel für die Verschlüsselung der Google-Tokens (AES-256-GCM).
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials).
# Scopes: https://www.googleapis.com/auth/calendar + openid + email.
# GOOGLE_REDIRECT_URI muss ZEICHENGENAU als "Authorized redirect URI" in der
# Cloud Console stehen. Lokal: http://localhost:3210/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bregenz-barbershop.at/api/google/callback

# Instagram / Meta Graph API (optional).
# Ohne diese Werte nutzt die Galerie die manuell gepflegten Bilder aus der Datenbank.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Google Business Profile (optional) — für echte Rezensionen.
# Fehlen die Werte, bleibt der Bewertungsblock auf der Website ausgeblendet.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_PROFILE_URL=

# Admin-Sessions und Signatur des OAuth-state-Parameters.
# Ohne diesen Wert lässt sich kein Google-Konto verbinden. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Telegram: Verwaltung als Mini App im Bot (optional).
# Ohne TELEGRAM_BOT_TOKEN ist die Anbindung aus; /admin bleibt im Browser
# unverändert. Token vom @BotFather, Secret frei wählbar:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Danach einmalig einrichten:  node scripts/telegram-setup.js
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Öffentliche https-Adresse der Website. Telegram öffnet Mini Apps nur über
# https; auf Vercel genügt sonst die automatische VERCEL_URL.
PUBLIC_BASE_URL=https://bregenzbarbershop.vercel.app
